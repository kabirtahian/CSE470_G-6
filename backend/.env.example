# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# ---------------------------------------------------------------------
# Database (MySQL - dev/production)
# ---------------------------------------------------------------------
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mfnet
DB_USER=root
DB_PASSWORD=

# Set DB_DIALECT=sqlite and DB_STORAGE=:memory: (or a file path) to run
# against SQLite instead - used by the automated smoke test when a real
# MySQL server isn't available.
DB_STORAGE=:memory:

# ---------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ---------------------------------------------------------------------
# Payment gateway
# ---------------------------------------------------------------------
# PAYMENT_PROVIDER selects which adapter in src/utils/gateways/ handles
# payments. Nothing about the provider is hardcoded anywhere in the
# controllers - swapping this value is the whole switch.
#
#   stripe -> real Stripe PaymentIntents + Stripe Elements
#   mock   -> the app's own simulator page, no network calls, no account
#
# If you pick a provider whose credentials are missing, the app falls back
# to mock automatically rather than crashing, so the demo always works.
PAYMENT_PROVIDER=stripe

# Get these from https://dashboard.stripe.com/test/apikeys
# The secret key must NEVER be committed or exposed to the browser.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Only needed if you're receiving real webhooks. For local development run:
#   stripe listen --forward-to localhost:5000/api/payments/webhook
# and paste the whsec_... value it prints here.
#
# Without a webhook secret the app still works: after Stripe Elements
# reports success the portal calls /confirm, which re-reads the
# PaymentIntent from Stripe server-side before crediting anything.
STRIPE_WEBHOOK_SECRET=

# Charge currency. MFNet's ledger is BDT throughout, but Stripe test
# accounts don't always have BDT enabled as a charge currency, so this
# defaults to usd. Set it to bdt if your Stripe account supports it.
PAYMENT_CURRENCY=usd

# ---------------------------------------------------------------------
# AI assistant
# ---------------------------------------------------------------------
# The key is read here and used only server-side - the browser talks to
# /api/assistant/chat and never sees the credential.
#
# AI_PROVIDER=gemini  -> Google's native generateContent endpoint.
#                        Works with both "AIza..." and newer "AQ..." keys.
# AI_PROVIDER=openai  -> any OpenAI-compatible /chat/completions endpoint
#                        (OpenAI, Groq, OpenRouter, a local Ollama...).
#                        Set AI_API_URL to that provider's base URL.
#
# Leave AI_API_KEY blank and the assistant still answers, using the
# built-in MFNet guide in src/utils/aiFallback.js instead of a live model.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_API_URL=
AI_TIMEOUT_MS=20000

# Per-user throttle on the assistant, so one visitor can't burn the quota.
AI_RATE_WINDOW_MS=60000
AI_RATE_MAX=15
